AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
IMAGE_PROVIDER=nanobanana_expert
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_FALLBACK_MODEL=gemini-2.5-flash-image
GEMINI_IMAGE_PRO_MODEL=gemini-3-pro-image
GEMINI_IMAGE_SIZE=1K

NANOBANANA_EXPERT_API_KEY=
NANOBANANA_EXPERT_BASE_URL=https://nanobanana.expert/api/v1
NANOBANANA_EXPERT_MODEL=nb2
NANOBANANA_EXPERT_PROVIDER=auto
NANOBANANA_EXPERT_RESOLUTION=1k
NANOBANANA_EXPERT_ASPECT_RATIO=4:5

OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5:7b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

HUGGINGFACE_API_KEY=
HUGGINGFACE_TEXT_MODEL=Qwen/Qwen2.5-7B-Instruct
HUGGINGFACE_IMAGE_PROVIDER=auto
HUGGINGFACE_IMAGE_PROVIDERS=auto,replicate,fal-ai
HUGGINGFACE_IMAGE_MODEL=Qwen/Qwen-Image-Edit

# Auth (обязательно для входа и кабинета)
AUTH_SECRET=сгенерируйте_длинную_случайную_строку
AUTH_URL=https://marketcard-ai.avenir-team.ru
AUTH_TRUST_HOST=true
NEXT_PUBLIC_SITE_URL=https://marketcard-ai.avenir-team.ru

# YooKassa payments
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RECEIPT_VAT_CODE=1
# Optional. Set if YooKassa asks for tax_system_code because several tax systems are enabled.
YOOKASSA_TAX_SYSTEM_CODE=
# Webhook URL for YooKassa dashboard: https://your-domain.com/api/payments/webhook

# Админка: email через запятую с доступом к /admin
ADMIN_LOGIN=1234
ADMIN_PASSWORD=1234ВаННа
ADMIN_EMAILS=you@example.com

# Яндекс OAuth — https://oauth.yandex.ru/client/new
AUTH_YANDEX_ID=
AUTH_YANDEX_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=MarketCard AI <noreply@your-domain.com>

# VK ID — https://id.vk.com/about/business/go
AUTH_VK_ID=54667428
NEXT_PUBLIC_VK_APP_ID=54667428
NEXT_PUBLIC_VK_REDIRECT_URL=https://marketcard-ai.avenir-team.ru/
NEXT_PUBLIC_VK_APP_NAME=MarketCard AI
